{
  "manifest_version": 3,
  "name": "Kokoro Reader",
  "version": "1.1.0",
  "description": "Reads any webpage (and O'Reilly books) aloud using a local, offline Kokoro TTS server (127.0.0.1:8880).",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8880/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://learning.oreilly.com/*"],
      "js": ["Readability.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Kokoro Reader: show/hide the read-aloud panel on this page" },
  "commands": {
    "toggle-play": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Play / pause reading"
    }
  }
}
